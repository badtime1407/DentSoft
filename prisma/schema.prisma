generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ผู้ใช้งานทั้งหมด
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique  // เพิ่มตรงนี้
  password  String
  role      Role     @default(PATIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient  Patient?
  dentist  Dentist?
  accounts Account[]
  sessions Session[]
}

enum Role {
  PATIENT
  DENTIST
  ADMIN
}

// ข้อมูลคนไข้
model Patient {
  id          String        @id @default(cuid())
  userId      String?       @unique
  firstName   String
  lastName    String
  phone       String?
  birthDate   DateTime?
  source      PatientSource @default(ONLINE)
  allergyNote String?
  createdAt   DateTime      @default(now())

  user         User?         @relation(fields: [userId], references: [id])
  appointments Appointment[]

  @@index([phone])
}

enum PatientSource {
  ONLINE  // สมัครสมาชิกเองผ่านเว็บไซต์
  WALK_IN // แอดมินเพิ่มให้ที่คลินิก ไม่มีบัญชีเข้าสู่ระบบ
}

// ข้อมูลทันตแพทย์
model Dentist {
  id          String   @id @default(cuid())
  userId      String   @unique
  title       String   @default("ทพ.")
  firstName   String
  lastName    String
  specialty   String?
  phone       String?
  createdAt   DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id])
  appointments Appointment[]
  schedules    Schedule[]
}

// ตารางการทำงานทันตแพทย์
model Schedule {
  id        String   @id @default(cuid())
  dentistId String
  dayOfWeek Int      // 0=อาทิตย์, 1=จันทร์ ... 6=เสาร์
  startTime String   // "09:00"
  endTime   String   // "17:00"
  isActive  Boolean  @default(true)

  dentist Dentist @relation(fields: [dentistId], references: [id])
}

// บริการทันตกรรม
model Service {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  category    String      // หมวดหมู่ เช่น "ศัลยกรรมภายในช่องปาก"
  type        ServiceType @default(MAIN)
  duration    Int?        // นาที โดยประมาณ (ไม่มีสำหรับ ADD_ON บางรายการ)
  minPrice    Float
  maxPrice    Float
  isActive    Boolean     @default(true)

  appointments Appointment[]
}

enum ServiceType {
  MAIN    // บริการหลักที่คนไข้เลือกจองได้เอง
  ADD_ON  // รายการเสริมที่ผูกกับบริการหลักตอนบันทึกการรักษา
  PACKAGE // ชุดบริการที่รวมหลายหัตถการไว้ในราคาเดียว
}

// การนัดหมาย
model Appointment {
  id            String            @id @default(cuid())
  patientId     String
  dentistId     String?
  serviceId     String
  date          DateTime
  status        AppointmentStatus @default(PENDING)
  checkedInAt   DateTime?         // เวลาที่คนไข้มาถึงคลินิกและเริ่มรอคิว
  note          String?
  requestType   RequestType?      // คนไข้ขอยกเลิก/ขอเลื่อนนัด รอแอดมินพิจารณา
  requestReason String?
  requestedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  patient   Patient    @relation(fields: [patientId], references: [id])
  dentist   Dentist?   @relation(fields: [dentistId], references: [id])
  service   Service    @relation(fields: [serviceId], references: [id])
  treatment Treatment?

  @@index([date, status])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  WAITING       // คนไข้มาถึงคลินิกแล้ว รอคิวพบทันตแพทย์
  IN_TREATMENT  // กำลังรักษาอยู่
  CANCELLED
  COMPLETED
}

enum RequestType {
  CANCEL
  RESCHEDULE
}

// บันทึกการรักษา
model Treatment {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  toothNumber   String?  // ฟันที่รักษา
  diagnosis     String?  // ปัญหาที่พบ
  treatmentNote String?  // แนวทางการรักษา
  nextVisit     DateTime?
  createdAt     DateTime @default(now())

  appointment Appointment     @relation(fields: [appointmentId], references: [id])
  items       TreatmentItem[]
}

// รายการที่ทำระหว่างการรักษาครั้งนั้นๆ (พิมพ์อิสระโดยทันตแพทย์ ไม่ผูกกับ Service)
model TreatmentItem {
  id          String   @id @default(cuid())
  treatmentId String
  text        String
  createdAt   DateTime @default(now())

  treatment Treatment @relation(fields: [treatmentId], references: [id])

  @@index([treatmentId])
}

// NextAuth Tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
