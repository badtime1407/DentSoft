generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ผู้ใช้งานทั้งหมด
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique  // เพิ่มตรงนี้
  password  String
  role      Role     @default(PATIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient  Patient?
  dentist  Dentist?
  accounts Account[]
  sessions Session[]
}

enum Role {
  PATIENT
  DENTIST
  ADMIN
}

// ข้อมูลคนไข้
model Patient {
  id          String        @id @default(cuid())
  userId      String?       @unique
  firstName   String
  lastName    String
  phone       String?
  birthDate   DateTime?
  source      PatientSource @default(ONLINE)
  allergyNote String?
  createdAt   DateTime      @default(now())

  user           User?           @relation(fields: [userId], references: [id])
  appointments   Appointment[]
  treatmentPlans TreatmentPlan[]

  @@index([phone])
}

enum PatientSource {
  ONLINE  // สมัครสมาชิกเองผ่านเว็บไซต์
  WALK_IN // แอดมินเพิ่มให้ที่คลินิก ไม่มีบัญชีเข้าสู่ระบบ
}

// ข้อมูลทันตแพทย์
model Dentist {
  id          String   @id @default(cuid())
  userId      String   @unique
  title       String   @default("ทพ.")
  firstName   String
  lastName    String
  specialty   String?
  phone       String?
  createdAt   DateTime @default(now())

  user                  User                @relation(fields: [userId], references: [id])
  appointments          Appointment[]
  schedules             Schedule[]
  services              DentistService[]
  createdTreatmentPlans TreatmentPlan[]
  createdPlanSteps      TreatmentPlanStep[]
}

// ตารางการทำงานทันตแพทย์
model Schedule {
  id        String   @id @default(cuid())
  dentistId String
  dayOfWeek Int      // 0=อาทิตย์, 1=จันทร์ ... 6=เสาร์
  startTime String   // "09:00"
  endTime   String   // "17:00"
  isActive  Boolean  @default(true)

  dentist Dentist @relation(fields: [dentistId], references: [id])
}

// บริการทันตกรรม
model Service {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  category    String      // หมวดหมู่ เช่น "ศัลยกรรมภายในช่องปาก"
  type        ServiceType @default(MAIN)
  duration    Int?        // นาที โดยประมาณ (ไม่มีสำหรับ ADD_ON บางรายการ)
  minPrice    Float
  maxPrice    Float
  isActive    Boolean     @default(true)

  appointments Appointment[]
  dentists     DentistService[]
  treatmentAddOns TreatmentAddOn[]
}

// หมอคนไหนทำบริการไหนได้บ้าง (many-to-many)
model DentistService {
  id        String   @id @default(cuid())
  dentistId String
  serviceId String
  createdAt DateTime @default(now())

  dentist Dentist @relation(fields: [dentistId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@unique([dentistId, serviceId])
  @@index([dentistId])
  @@index([serviceId])
}

enum ServiceType {
  MAIN    // บริการหลักที่คนไข้เลือกจองได้เอง
  ADD_ON  // รายการเสริมที่ผูกกับบริการหลักตอนบันทึกการรักษา
  PACKAGE // ชุดบริการที่รวมหลายหัตถการไว้ในราคาเดียว
}

// การนัดหมาย
model Appointment {
  id            String            @id @default(cuid())
  patientId     String
  dentistId     String?
  serviceId     String
  date          DateTime
  status        AppointmentStatus @default(PENDING)
  checkedInAt   DateTime?         // เวลาที่คนไข้มาถึงคลินิกและเริ่มรอคิว
  note          String?
  requestType   RequestType?      // คนไข้ขอยกเลิก/ขอเลื่อนนัด รอแอดมินพิจารณา
  requestReason String?
  requestedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  patient   Patient    @relation(fields: [patientId], references: [id])
  dentist   Dentist?   @relation(fields: [dentistId], references: [id])
  service   Service    @relation(fields: [serviceId], references: [id])
  treatment Treatment?
  planStep  TreatmentPlanStep?

  @@index([date, status])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  WAITING       // คนไข้มาถึงคลินิกแล้ว รอคิวพบทันตแพทย์
  IN_TREATMENT  // กำลังรักษาอยู่
  CANCELLED
  COMPLETED
}

enum RequestType {
  CANCEL
  RESCHEDULE
}

// บันทึกการรักษา
model Treatment {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  toothNumber   String?  // ฟันที่รักษา
  diagnosis     String?  // ปัญหาที่พบ
  treatmentNote String?  // แนวทางการรักษา
  servicePrice  Float?   // ราคาจริงที่คิดสำหรับบริการหลักของนัดนี้ (ยืนยัน/ปรับภายในช่วง minPrice-maxPrice ของ Service ตอนบันทึกการรักษา)
  nextVisit     DateTime?
  nextVisitNote String?  // นัดครั้งถัดไปเพื่อทำอะไร กรอกอิสระโดยทันตแพทย์
  createdAt     DateTime @default(now())

  appointment Appointment     @relation(fields: [appointmentId], references: [id])
  items       TreatmentItem[]
  images      TreatmentImage[]
  addOns      TreatmentAddOn[]
}

// บริการเสริม (ADD_ON) จริงจากแคตตาล็อกที่ใช้ระหว่างการรักษาครั้งนั้นๆ
// เก็บ unitPrice เป็น snapshot ตอนใช้งานจริง กันราคาผันผวนถ้าแคตตาล็อกเปลี่ยนทีหลัง
model TreatmentAddOn {
  id          String   @id @default(cuid())
  treatmentId String
  serviceId   String?  // null เมื่อหมอพิมพ์รายการ/ราคาเองแทนการเลือกจากแคตตาล็อก
  customName  String?  // ชื่อรายการตอนไม่ได้ผูกกับ Service
  quantity    Int      @default(1)
  unitPrice   Float
  createdAt   DateTime @default(now())

  treatment Treatment @relation(fields: [treatmentId], references: [id])
  service   Service?  @relation(fields: [serviceId], references: [id])

  @@index([treatmentId])
  @@index([serviceId])
}

// รายการที่ทำระหว่างการรักษาครั้งนั้นๆ (พิมพ์อิสระโดยทันตแพทย์ ไม่ผูกกับ Service)
model TreatmentItem {
  id          String   @id @default(cuid())
  treatmentId String
  text        String
  createdAt   DateTime @default(now())

  treatment Treatment @relation(fields: [treatmentId], references: [id])

  @@index([treatmentId])
}

// แผนการรักษาระยะยาวของคนไข้ (ครอบคลุมหลายนัดหมาย เช่น รักษารากฟันแล้วครอบฟัน)
model TreatmentPlan {
  id                String              @id @default(cuid())
  patientId         String
  title             String              // ชื่อแผน เช่น "รักษารากฟันซี่ 36 + ครอบฟัน"
  status            TreatmentPlanStatus @default(ACTIVE)
  createdByDentistId String
  createdAt         DateTime            @default(now())

  patient         Patient             @relation(fields: [patientId], references: [id])
  createdByDentist Dentist            @relation(fields: [createdByDentistId], references: [id])
  steps            TreatmentPlanStep[]

  @@index([patientId])
}

enum TreatmentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// ขั้นตอนแต่ละครั้งในแผนการรักษา ผูกกับนัดหมายจริงได้เมื่อถูกจองแล้ว
// createdByDentistId ใช้จำกัดสิทธิ์ลบ — ลบได้เฉพาะหมอที่เพิ่มขั้นตอนนั้นเอง ส่วนกาเช็ค/แก้ไข/เพิ่มขั้นตอนใหม่ หมอคนไหนก็ทำได้ (ต่องานกันได้)
model TreatmentPlanStep {
  id                String   @id @default(cuid())
  planId            String
  order             Int
  description       String
  isDone            Boolean  @default(false)
  appointmentId     String?  @unique
  createdByDentistId String
  createdAt         DateTime @default(now())

  plan             TreatmentPlan @relation(fields: [planId], references: [id])
  appointment      Appointment?  @relation(fields: [appointmentId], references: [id])
  createdByDentist Dentist       @relation(fields: [createdByDentistId], references: [id])

  @@index([planId])
}

// รูปภาพ/X-ray ที่แนบกับการรักษาครั้งนั้นๆ เก็บไบต์ตรงในฐานข้อมูล (ไม่มี object storage ในโปรเจกต์นี้)
model TreatmentImage {
  id          String   @id @default(cuid())
  treatmentId String
  data        Bytes
  mimeType    String
  createdAt   DateTime @default(now())

  treatment Treatment @relation(fields: [treatmentId], references: [id])

  @@index([treatmentId])
}

// NextAuth Tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
